# 复制为 .env 后填写；不要提交 .env

# 阿里企业邮箱完整账号及客户端专用密码
MAIL_ACCOUNT=your-account@example.com
MAIL_PASSWORD=your-client-specific-password

# AI API
AI_API_KEY=your-ai-api-key

# Web Search（博查 API；仅作为低风险通用技术问题回退）
BOCHA_API_KEY=your-bocha-api-key

# MCPilot 固定 Bearer Token（生成后仅写入本地 .env）
# === email-ai-agent访问令牌 ===
EMAIL_AGENT_BASE_URL=http://127.0.0.1:8765
EMAIL_AGENT_API_TOKEN=replace-with-a-random-token
EMAIL_AGENT_TIMEOUT_SECONDS=10

# Embedding API（阿里云百炼 OpenAI 兼容接口）
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_MODEL=qwen3.7-text-embedding
